{
  "type": "record",
  "name": "RegionStats",
  "namespace": "dev.rahuldabola.quotes.avro",
  "doc": "Per-region totals for one tumbling window, upserted into Postgres by the JDBC sink connector.",
  "fields": [
    {"name": "region", "type": "string"},
    {"name": "window_start", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "window_end", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "quote_count", "type": "long"},
    {"name": "item_count", "type": "long"},
    {"name": "gross_amount_cents", "type": "long"}
  ]
}
